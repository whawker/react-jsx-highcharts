{
  "name": "react-jsx-highmaps",
  "version": "3.0.5",
  "description": "Highmaps built using React components",
  "main": "dist/react-jsx-highmaps.min.js",
  "module": "dist/es/index.js",
  "sideEffects": false,
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=development webpack",
    "build:prod": "npm run build:umd && npm run build:es",
    "build:umd": "cross-env NODE_ENV=production webpack",
    "build:es": "cross-env BABEL_ENV=es babel --extensions .tsx,.ts,.js,.jsx src --out-dir dist/es",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" README.md",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:dts": "tsc --project tsconfig.dts.json --noEmit",
    "test:types": "tsc --noEmit"
  },
  "author": "Will Hawker",
  "contributors": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/whawker/react-jsx-highcharts.git"
  },
  "bugs": "https://github.com/whawker/react-jsx-highcharts/issues",
  "homepage": "https://github.com/whawker/react-jsx-highcharts",
  "keywords": [
    "react",
    "reactjs",
    "react-component",
    "highcharts",
    "highmaps",
    "chart",
    "charts",
    "graphs",
    "visualization",
    "data",
    "maps"
  ],
  "dependencies": {
    "react-jsx-highcharts": "5.0.4"
  },
  "peerDependencies": {
    "highcharts": "^12.6.0 || ^13.0.2",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "types": "types/index.d.ts",
  "browserslist": [
    "chrome >= 120",
    "edge >= 120",
    "firefox >= 120",
    "ios >= 18",
    "safari >= 18"
  ]
}
