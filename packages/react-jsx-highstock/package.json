{
  "name": "react-jsx-highstock",
  "version": "6.0.0-alpha.0",
  "description": "Highcharts (including Highstock) charts built using React components",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "babel --extensions .tsx,.ts,.js,.jsx src --out-dir dist",
    "build:prod": "npm run build && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly",
    "clean": "rimraf dist",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" README.md",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit"
  },
  "author": "Will Hawker",
  "contributors": [
    {
      "name": "Alex Mayants",
      "url": "https://github.com/AlexMayants"
    },
    {
      "name": "mrawdon",
      "url": "https://github.com/mrawdon"
    },
    {
      "name": "Ercan Akyürek",
      "url": "https://github.com/geforcefan"
    },
    {
      "name": "anajavi",
      "url": "https://github.com/anajavi"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/whawker/react-jsx-highcharts.git"
  },
  "bugs": "https://github.com/whawker/react-jsx-highcharts/issues",
  "homepage": "https://github.com/whawker/react-jsx-highcharts",
  "keywords": [
    "react",
    "reactjs",
    "react-component",
    "highcharts",
    "highstock",
    "chart",
    "charts",
    "graphs",
    "visualization",
    "data"
  ],
  "dependencies": {
    "react-jsx-highcharts": "6.0.0-alpha.0"
  },
  "peerDependencies": {
    "highcharts": "^12.6.0 || ^13.0.2",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "browserslist": [
    "chrome >= 120",
    "edge >= 120",
    "firefox >= 120",
    "ios >= 18",
    "safari >= 18"
  ]
}
