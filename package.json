    "@babel/preset-typescript": "^8.0.1",
    "@eslint/compat": "^2.1.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-loader": "^10.1.1",
    "canvas": "^3.2.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
